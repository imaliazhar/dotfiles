#!/usr/bin/env bash
# Generate aerospace.toml from base.toml plus a monitors/<profile>.toml workspace-to-monitor assignment.
#
# Usage: monitor            pick a profile with fzf
#        monitor PROFILE    e.g. monitor built-in

set -euo pipefail

DIR="$HOME/.config/aerospace"
CONFIG="$DIR/aerospace.toml"

profiles() {
  local file
  for file in "$DIR"/monitors/*.toml; do
    basename "$file" .toml
  done
}

usage() {
  echo "Usage: monitor [PROFILE], where PROFILE is one of:" >&2
  profiles | sed 's/^/  /' >&2
  exit 1
}

case $# in
0)
  current="$(sed -n 's/^# monitor-mode: //p' "$CONFIG" 2>/dev/null || true)"
  profile="$(profiles | fzf --header "current: ${current:-none}" --height 40% --reverse)" || exit 0
  ;;
1) profile="$1" ;;
*) usage ;;
esac

grep -qx "$profile" < <(profiles) || usage

{
  echo "# Generated by monitor from base.toml and monitors/$profile.toml, edit those instead"
  echo "# monitor-mode: $profile"
  echo
  cat "$DIR/base.toml"
  echo
  cat "$DIR/monitors/$profile.toml"
} >"$CONFIG"

echo "Switched to $profile monitor profile"

if pgrep -xq AeroSpace; then
  aerospace reload-config
fi

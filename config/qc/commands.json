{
  "commands": [
    {
      "key": "b",
      "description": "Move bar to second monitor",
      "command": "sketchybar --bar display=2"
    },
    {
      "key": "B",
      "description": "Move bar to first monitor",
      "command": "sketchybar --bar display=1"
    },
    {
      "key": "k",
      "description": "Setup App Native Kit",
      "command": "rm -fr $HOME/Projects/ronald/node_modules/@goeuro/app-rn-bundles/app-native-kit && ln -s $PWD/packages/app-native-kit/ $HOME/Projects/ronald/node_modules/@goeuro/app-rn-bundles/app-native-kit && rm -fr $HOME/Projects/rosie/node_modules/@goeuro/app-rn-bundles/app-native-kit && ln -s $PWD/packages/app-native-kit/ $HOME/Projects/rosie/node_modules/@goeuro/app-rn-bundles/app-native-kit"
    },
    {
      "key": "s",
      "description": "Disable sleep",
      "command": "sudo pmset -a disablesleep "
    },
    {
      "key": "S",
      "description": "Enable sleep",
      "command": "sudo pmset -a disablesleep 1"
    }
  ]
}

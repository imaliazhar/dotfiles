#!/usr/bin/env bash
# Switch lazygit, yazi, wezterm, tmux, nvim and Claude Code to a theme.
#
# Usage: theme              pick a theme and mode with fzf
#        theme NAME MODE    e.g. theme rose-pine dark
#        theme MODE         keep the current theme, switch to dark or light

set -euo pipefail

CONFIG="$HOME/.config"
THEMES="$CONFIG/theme"
CURRENT="$THEMES/current"

# Prints "NAME MODE" for every mode a theme provides
variants() {
  local file theme
  for file in "$THEMES"/*/nvim/*.lua; do
    theme="${file#"$THEMES"/}"
    echo "${theme%%/*} $(basename "$file" .lua)"
  done
}

usage() {
  echo "Usage: theme [NAME] [MODE], where NAME MODE is one of:" >&2
  variants | sed 's/^/  /' >&2
  exit 1
}

case $# in
0)
  current="$(cat "$CURRENT" 2>/dev/null || true)"
  choice="$(
    variants | fzf --header "current: ${current:-none}" --height 40% --reverse
  )" || exit 0
  read -r name mode <<<"$choice"
  ;;
1)
  read -r name _ <"$CURRENT" || usage
  mode="$1"
  ;;
2)
  name="$1"
  mode="$2"
  ;;
*) usage ;;
esac

grep -qx "$name $mode" < <(variants) || usage

link() {
  mkdir -p "$(dirname "$2")"
  ln -sfn "$THEMES/$name/$1" "$2"
}

link "lazygit/$mode.yml" "$CONFIG/lazygit/theme.yml"
link "yazi/$mode" "$CONFIG/yazi/flavors/theme.yazi"
link "wezterm/$mode.lua" "$CONFIG/wezterm/theme.lua"
link "tmux/$mode.tmux" "$CONFIG/tmux/theme.tmux"
link "nvim/$mode.lua" "$CONFIG/nvim/theme.lua"
# Selected in Claude Code with /theme as custom:current
link "claude/$mode.json" "$HOME/.claude/themes/current.json"

echo "$name $mode" >"$CURRENT"
echo "Switched to $name $mode"

# Touch the config so wezterm reloads it
touch "$CONFIG/wezterm/wezterm.lua"

tmux source-file "$CONFIG/tmux/tmux.conf" 2>/dev/null || true

for socket in "${TMPDIR:-/tmp/}"nvim."$USER"/*/nvim.*; do
  [[ -S "$socket" ]] || continue
  nvim --server "$socket" --remote-expr 'execute("source ~/.config/nvim/after/plugin/theme.lua")' >/dev/null 2>&1 || true
done

# https://github.com/xero/miasma.nvim

set -g pane-border-style fg="#444444"
set -g pane-active-border-style fg="#c9a554"

set -g status-bg "#1c1c1c"
set -g status-fg "#666666"
set-window-option -g window-status-current-style fg="#d7c483"

set -g popup-border-style 'fg=#bb7744'
set -g popup-border-line rounded

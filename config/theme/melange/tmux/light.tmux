# https://github.com/savq/melange-nvim

set -g pane-border-style fg="#A98A78"
set -g pane-active-border-style fg="#BC5C00"

set -g status-bg "#E9E1DB"
set -g status-fg "#7D6658"
set-window-option -g window-status-current-style fg="#54433A"

set -g popup-border-style 'fg=#BC5C00'
set -g popup-border-line rounded

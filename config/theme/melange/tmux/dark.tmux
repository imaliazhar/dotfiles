# https://github.com/savq/melange-nvim

set -g pane-border-style fg="#867462"
set -g pane-active-border-style fg="#E49B5D"

set -g status-bg "#34302C"
set -g status-fg "#C1A78E"
set-window-option -g window-status-current-style fg="#ECE1D7"

set -g popup-border-style 'fg=#E49B5D'
set -g popup-border-line rounded
